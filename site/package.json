{
  "name": "sudan-atlas-site",
  "private": true,
  "version": "0.1.0",
  "description": "The Sudan Atlas website: map explorer, map-maker and documentation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "data": "node ../packages/js/scripts/copy-data.mjs && node scripts/copy-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run data && tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/inter-tight": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/analytics": "^1.5.0",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "papaparse": "^5.5.3",
    "read-excel-file": "^5.8.0",
    "sudan-atlas": "^0.1.2",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/papaparse": "^5.3.16",
    "@types/topojson-client": "^3.1.5",
    "playwright-core": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild": true
  }
}
